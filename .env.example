# Keep this file safe to commit. Put real values only in .env (which is ignored by Git).
# The API uses this direct PostgreSQL URL at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Prisma migrations use the same direct URL. Keep a separate value only if your provider requires it.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
PORT=3000
# In production, use your exact chrome-extension://<extension-id> origin(s), comma-separated.
# ALLOWED_ORIGINS="chrome-extension://your-extension-id"
